datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       // "ADMIN", "INSPECTOR", "SUPERVISOR"
  inspections  Inspection[] @relation("InspectorRelation")
  approvals    Inspection[] @relation("SupervisorRelation")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Inspection {
  id            String             @id @default(uuid())
  date          DateTime
  status        String             // "DRAFT", "SUBMITTED", "APPROVED"
  inspectorId   String
  inspector     User               @relation("InspectorRelation", fields: [inspectorId], references: [id])
  supervisorId  String?
  supervisor    User?              @relation("SupervisorRelation", fields: [supervisorId], references: [id])
  details       InspectionDetail[]
  signature     String?            // Base64 signature image or path
  // Matrix-style results aligned with the YIA worksheet format
    matrixResults String?              // JSON string storing S/US values for runway/taxiway/apron matrix
  // Bottom panel fields
  rubberDepositRunway11 String?    // L / M / H
  rubberDepositRunway29 String?    // L / M / H
  notam          String?
  fodCondition   String?            // SERVICEABLE / UNSERVICEABLE
  standingWaterCondition String?
  obstacleCondition String?
  pavementCondition String?
  // Pavement surface temperatures (°C)
  pavementTempRunway11  String?
  pavementTempRunway29  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model InspectionItem {
  id         String             @id @default(uuid())
  zone       String             // "RUNWAY", "TAXIWAY", "APRON", "DRAINAGE", "PERIMETER_FENCE"
  category   String             // e.g., "Surface", "Marking", "Runway Strip", "RESA", "Drainage", "Perimeter Fence"
  name       String             // e.g., "Centerline marking", "Potholes", "Edge Light"
  matrixKey  String?            // Maps to specific cell position in the YIA worksheet (e.g., "RUNWAY_11_SURFACE_S", "DRAINAGE_1_CONDITION")
  order      Int                @default(0)
  details    InspectionDetail[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model InspectionDetail {
  id           String         @id @default(uuid())
  inspectionId String
  inspection   Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       String
  item         InspectionItem @relation(fields: [itemId], references: [id])
  status       String         // "BAIK", "RUSAK", "NA"
  remarks      String?
  photoUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ===================== Airside Monitoring =====================

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Facility {
  id          String           @id @default(uuid())
  code        String           @unique // "RWY-11/29", "TWY-A", "APRON-1"
  name        String
  type        String // RUNWAY | TAXIWAY | APRON
  lengthM     Float?
  widthM      Float?
  areaSqm     Float?
  surfaceType String? // ASPHALT | CONCRETE
  pcn         String? // "PCN 60 F/B/W/T"
  pcr         String? // "PCR 74 F/B/W/T" (ICAO Annex 14 Vol I ed. ke-18)
  bearingDeg  Float? // azimuth utama fasilitas (untuk stationing runway)
  centroidLat Float?
  centroidLng Float?
  polygonJson String? // JSON [{lat,lng},...] batas fasilitas
  color       String?
  status      String? // SERVICEABLE | CAUTION | UNSERVICEABLE
  remarks     String?
  stationDirection String?   @default("FORWARD") // FORWARD (Awal ke Akhir) | REVERSE (Akhir ke Awal)
  stationIntervalM Float?    @default(50) // Jarak interval garis STA dalam meter (misal 10, 25, 50, 100)
  locationMode     String?   @default("STA") // STA | SAM
  sampleLengthM    Float?    @default(20) // Panjang per sampel dalam meter
  sampleWidthM     Float?    @default(20) // Lebar per sampel dalam meter
  blockLengthM     Float?    @default(5)  // Panjang per blok/slab concrete (m)
  blockWidthM      Float?    @default(5)  // Lebar per blok/slab concrete (m)
  slabDirection    String?   @default("FORWARD") // FORWARD (Slab A kiri atas) | REVERSE (Slab A kanan bawah)
  pciCorrection    Float     @default(100)
  damages     Damage[]
  markings    MarkingFinding[]
  pciSections PciSection[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model MapLayer {
  id           String   @id @default(uuid())
  name         String
  fileName     String
  refLat       Float // titik acuan DXF (biasanya ARP)
  refLng       Float
  rotationDeg  Float    @default(0) // rotasi drawing thd utara sejati (CW positif)
  scale        Float    @default(1) // 1 satuan gambar = ? meter
  entitiesJson String // hasil parse DXF (koordinat lokal meter)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Damage {
  id         String    @id @default(uuid())
  groupId    String?   // ID kelompok untuk temuan yang terbagi/dipecah otomatis per segmen STA
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id])
  station    String? // "RWY 11 + 1250", "TWY A3", ...
  sampleCode String? // "SAM-1", "SAM-2", ... jika mode SAM
  type       String // jenis kerusakan (lihat src/lib/constants.ts)
  severity   String // L | M | H
  lat        Float // koordinat Google (WGS84)
  lng        Float
  localX     Float // koordinat aerodrome: East dari ARP (m)
  localY     Float // koordinat aerodrome: North dari ARP (m)
  rectJson   String? // JSON titik geometri asal: poligon/slab (>=3), garis (>=2), atau null untuk titik
  geometryType String @default("POLYGON") // POLYGON | LINE | POINT | SLAB
  lengthM    Float?
  widthM     Float?
  areaSqm    Float     @default(0)
  count      Int? // jumlah kejadian/slab; tidak diturunkan dari luas
  photoUrl   String?
  remarks    String?
  status     String    @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  reportedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MarkingFinding {
  id          String    @id @default(uuid())
  facilityId  String?
  facility    Facility? @relation(fields: [facilityId], references: [id])
  markingType String // CENTERLINE, THRESHOLD, TDZ, ...
  condition   String // BAIK | PERLU_PERBAIKAN | USANG
  station     String?
  lat         Float?
  lng         Float?
  localX      Float?
  localY      Float?
  areaSqm     Float?
  remarks     String?
  photoUrl    String?
  status      String    @default("OPEN") // OPEN | CLOSED
  reportedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PciSection {
  id             String      @id @default(uuid())
  facilityId     String?
  facility       Facility?   @relation(fields: [facilityId], references: [id])
  name           String // "RWY 11/29 - Seksi 1"
  surfaceType    String // ASPHALT | JPCP
  totalAreaSqm   Float
  sampleUnitArea Float       @default(225) // 225 m2 (AS) / 20 slab (JPCC ~ 232 m2)
  lastPci        Float?
  lastSurveyAt   DateTime?
  surveys        PciSurvey[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model PciSurvey {
  id            String     @id @default(uuid())
  sectionId     String
  section       PciSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  inspectorName String?
  surveyDate    DateTime
  pci           Float // PCI section (rata-rata tertimbang sample unit)
  rating        String // EXCELLENT ... FAILED
  detailsJson   String // [{no, areaSqm, distresses, dv, totalDv, maxCdv, pci}]
  createdAt     DateTime   @default(now())
}
