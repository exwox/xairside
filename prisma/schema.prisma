datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Airport {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  timezone  String   @default("Asia/Jakarta")
  isActive  Boolean  @default(true)
  refLat    Float    @default(0.9569)
  refLng    Float    @default(104.5311)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  facilities  Facility[]
  damages     Damage[]
  markings    MarkingFinding[]
  mapLayers   MapLayer[]
  pciSections PciSection[]
  pciSurveys  PciSurvey[]
  inspections Inspection[]
  configs     AirportConfig[]
  backupLogs  BackupLog[]
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       // "SUPADMIN", "ADMIN", "USER", "VIEWER"
  airportId    String?
  airport      Airport?     @relation(fields: [airportId], references: [id], onDelete: SetNull)
  isActive     Boolean      @default(true)
  inspections  Inspection[] @relation("InspectorRelation")
  approvals    Inspection[] @relation("SupervisorRelation")
  sessions     Session[]
  backupLogs   BackupLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([airportId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AirportConfig {
  id        String   @id @default(uuid())
  airportId String
  airport   Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([airportId, key])
  @@index([airportId])
}

model Inspection {
  id                    String             @id @default(uuid())
  airportId             String
  airport               Airport            @relation(fields: [airportId], references: [id], onDelete: Cascade)
  date                  DateTime
  status                String             // "DRAFT", "SUBMITTED", "APPROVED"
  inspectorId           String
  inspector             User               @relation("InspectorRelation", fields: [inspectorId], references: [id])
  supervisorId          String?
  supervisor            User?              @relation("SupervisorRelation", fields: [supervisorId], references: [id])
  details               InspectionDetail[]
  signature             String?            // Base64 signature image or path
  matrixResults         String?            // JSON string storing S/US values
  rubberDepositRunway11 String?            // L / M / H
  rubberDepositRunway29 String?            // L / M / H
  notam                 String?
  fodCondition          String?            // SERVICEABLE / UNSERVICEABLE
  standingWaterCondition String?
  obstacleCondition     String?
  pavementCondition     String?
  pavementTempRunway11  String?
  pavementTempRunway29  String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([airportId])
}

model InspectionItem {
  id         String             @id @default(uuid())
  zone       String             // "RUNWAY", "TAXIWAY", "APRON", "DRAINAGE", "PERIMETER_FENCE"
  category   String             // e.g., "Surface", "Marking", "Runway Strip", "RESA", "Drainage", "Perimeter Fence"
  name       String             // e.g., "Centerline marking", "Potholes", "Edge Light"
  matrixKey  String?            // Maps to specific cell position in the YIA worksheet (e.g., "RUNWAY_11_SURFACE_S", "DRAINAGE_1_CONDITION")
  order      Int                @default(0)
  details    InspectionDetail[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model InspectionDetail {
  id           String         @id @default(uuid())
  inspectionId String
  inspection   Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       String
  item         InspectionItem @relation(fields: [itemId], references: [id])
  status       String         // "BAIK", "RUSAK", "NA"
  remarks      String?
  photoUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ===================== Airside Monitoring =====================

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Facility {
  id               String           @id @default(uuid())
  airportId        String
  airport          Airport          @relation(fields: [airportId], references: [id], onDelete: Cascade)
  code             String           // "RWY-11/29", "TWY-A", "APRON-1"
  name             String
  type             String           // RUNWAY | TAXIWAY | APRON
  lengthM          Float?
  widthM           Float?
  areaSqm          Float?
  surfaceType      String?          // ASPHALT | CONCRETE
  pcn              String?
  pcr              String?
  bearingDeg       Float?
  centroidLat      Float?
  centroidLng      Float?
  polygonJson      String?
  color            String?
  status           String?          // SERVICEABLE | CAUTION | UNSERVICEABLE
  remarks          String?
  stationDirection String?          @default("FORWARD")
  stationIntervalM Float?           @default(50)
  locationMode     String?          @default("STA")
  sampleLengthM    Float?           @default(20)
  sampleWidthM     Float?           @default(20)
  blockLengthM     Float?           @default(5)
  blockWidthM      Float?           @default(5)
  slabDirection    String?          @default("FORWARD")
  pciCorrection    Float            @default(100)
  damages          Damage[]
  markings         MarkingFinding[]
  pciSections      PciSection[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([airportId, code])
  @@index([airportId])
}

model MapLayer {
  id           String   @id @default(uuid())
  airportId    String
  airport      Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)
  name         String
  fileName     String
  refLat       Float
  refLng       Float
  rotationDeg  Float    @default(0)
  scale        Float    @default(1)
  entitiesJson String
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([airportId])
}

model Damage {
  id           String    @id @default(uuid())
  airportId    String
  airport      Airport   @relation(fields: [airportId], references: [id], onDelete: Cascade)
  groupId      String?
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  station      String?
  sampleCode   String?
  type         String
  severity     String
  lat          Float
  lng          Float
  localX       Float
  localY       Float
  rectJson     String?
  geometryType String    @default("POLYGON")
  lengthM      Float?
  widthM       Float?
  areaSqm      Float     @default(0)
  count        Int?
  photoUrl     String?
  remarks      String?
  status       String    @default("OPEN")
  reportedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([airportId])
}

model MarkingFinding {
  id          String    @id @default(uuid())
  airportId   String
  airport     Airport   @relation(fields: [airportId], references: [id], onDelete: Cascade)
  facilityId  String?
  facility    Facility? @relation(fields: [facilityId], references: [id])
  markingType String
  condition   String
  station     String?
  lat         Float?
  lng         Float?
  localX      Float?
  localY      Float?
  areaSqm     Float?
  remarks     String?
  photoUrl    String?
  status      String    @default("OPEN")
  reportedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([airportId])
}

model PciSection {
  id             String      @id @default(uuid())
  airportId      String
  airport        Airport     @relation(fields: [airportId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?   @relation(fields: [facilityId], references: [id])
  name           String
  surfaceType    String
  totalAreaSqm   Float
  sampleUnitArea Float       @default(225)
  lastPci        Float?
  lastSurveyAt   DateTime?
  surveys        PciSurvey[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([airportId])
}

model PciSurvey {
  id            String     @id @default(uuid())
  airportId     String
  airport       Airport    @relation(fields: [airportId], references: [id], onDelete: Cascade)
  sectionId     String
  section       PciSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  inspectorName String?
  surveyDate    DateTime
  pci           Float
  rating        String
  detailsJson   String
  createdAt     DateTime   @default(now())

  @@index([airportId])
}

model BackupLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupType   String   // "AIRPORT" or "FULL_SYSTEM"
  airportId    String?
  airport      Airport? @relation(fields: [airportId], references: [id], onDelete: SetNull)
  fileName     String
  fileSize     Int      // in bytes
  format       String   // "JSON" or "SQL"
  includePhotos Boolean  @default(false)
  dataCount    String   // JSON string with count info
  status       String   @default("COMPLETED") // "COMPLETED", "RESTORED", "FAILED"
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([airportId])
  @@index([backupType])
}
